# Paste into Railway → API service → Variables
# Link Postgres first, then add the rest.

# Private/internal Postgres (no egress fees) — do NOT use the public proxy URL here
DATABASE_URL=${{Postgres.DATABASE_URL}}

NODE_ENV=production

JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SEED_SUPER_ADMIN_EMAIL=superadmin@pops.platform
SEED_SUPER_ADMIN_EMAIL_2=owner@pops.platform
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_USER_EMAIL=admin.restaurant@pops.demo
SEED_USER_PASSWORD=Owner@12345

CORS_ORIGINS=http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost,http://tauri.localhost,https://backend-system-production-28a3.up.railway.app

APP_PUBLIC_URL=http://127.0.0.1:1420

# Optional SMTP — when unset, invite links are logged to the API console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=POPS <noreply@yourdomain.com>

# Boot safety (defaults are already 1 in start-railway.mjs — set explicitly if desired)
# RAILWAY_SKIP_SCHEMA_PUSH=1
# RAILWAY_SKIP_SEED_BOOT=1

# Request load shed + DB pool (defaults match api code)
# API_MAX_CONCURRENT=40
# API_QUEUE_MAX=100
# DATABASE_POOL_MAX=20

# Do NOT set PORT — Railway injects it automatically
